# Copy to config/.env.local for local overrides (optional).
# Loaded after config/.env — use for local APP_URL without changing production .env.

APP_URL=http://localhost:8080
APP_ENV=local

# When developing on your PC, use the MySQL hostname from Hostinger hPanel
# (not "localhost" unless MySQL runs on this machine).
# DB_HOST=mysql123.hostinger.com
